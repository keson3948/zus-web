{{!
  Lokální náhrada za dataView poboček.

  DŮLEŽITÉ: vypisuje schválně stejné HTML jako Shipard na produkci,
  tedy <ul class="dataView-places-list"> s <li> a odkazem. Dřív tu byly
  vlastní třídy .location-list / .location-item – vypadalo to dobře
  lokálně, ale na produkci zůstal neostylovaný seznam s odrážkami,
  protože takové třídy Shipard nevypisuje.

  U tohohle dataView proto NENÍ parametr webScript, ten by produkční
  vykreslení přebil. Mapu od seznamu rozlišují příznaky showAsMap
  a showAsList z dev.js.
}}
{{#showAsMap}}
  <div class="location-map">
    <div class="map-grid"></div>
    <div class="map-label">
      <div class="map-label-title">Mapa poboček</div>
      <p>Na produkci sem Shipard vykreslí interaktivní mapu.</p>
    </div>
  </div>
{{/showAsMap}}

{{^showAsMap}}
  <div><ul class='dataView-places-list'>{{#data.places}}<li><a href='{{url}}'>{{name}}</a></li>{{/data.places}}</ul></div>
{{/showAsMap}}
