    <!-- Karusel na úvodní stránce.
         Vlastnosti položek: _2a = plakát, _28 = video, _23/_24 = štítek,
         _22 = popisek, _25 = zobrazit tlačítko, _26 = text, _27 = odkaz. -->
    <div class="hero hero-intro carousel slide" id="heroCarousel" data-bs-ride="carousel" data-bs-interval="7000" data-bs-pause="hover">
        <div class="hero-lines"></div>

        <div class="carousel-inner hero-items">
            {{#!webBlocks.kolotoc.items}}
              <div class="carousel-item">
                <div class="hero-grid">

                  <div class="hero-content">
                    {{#properties.bd2gq4ckw_23}}
                      <div class="section-label">{{{properties.bd2gq4ckw_24.value}}}</div>
                    {{/properties.bd2gq4ckw_23}}

                    {{! Tři závorky schválně: v názvu slidu smí být <em>slovo</em>,
                        které se vysází kurzívou v akcentní barvě. }}
                    {{#title}}
                      <h1 class="hero-title">{{{title}}}</h1>
                    {{/title}}

                    <div class="hero-subtitle">{{{properties.bd2gq4ckw_22.value}}}</div>

                    <div class="hero-actions">
                      {{#properties.bd2gq4ckw_25}}
                        <a href="{{{properties.bd2gq4ckw_27.value}}}" class="btn btn-primary">{{{properties.bd2gq4ckw_26.value}}}</a>
                      {{/properties.bd2gq4ckw_25}}
                    </div>
                  </div>

                  <div class="hero-visual">
                    <div class="hero-poster">
                      {{#properties.bd2gq4ckw_28}}
                        <video src="{{properties.bd2gq4ckw_28.value}}" autoplay loop muted playsinline></video>
                      {{/properties.bd2gq4ckw_28}}
                      {{^properties.bd2gq4ckw_28}}
                        <img src="{{serverRoot}}/att/{{pictureUrl}}" alt="{{title}}">
                      {{/properties.bd2gq4ckw_28}}
                    </div>
                  </div>

                </div>
              </div>
            {{/!webBlocks.kolotoc.items}}
        </div>

        <div class="hero-nav">
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide="prev" aria-label="Předchozí">
                <i class="fa fa-angle-left"></i>
            </button>
            <button type="button" data-bs-target="#heroCarousel" data-bs-slide="next" aria-label="Další">
                <i class="fa fa-angle-right"></i>
            </button>
        </div>
    </div>
