<script>
// Nálet hero doběhne zhruba za 1,5 s. Pak třídu odebereme, aby se
// animace nespouštěla znovu při přepínání snímků karuselu.
(function () {
	var hero = document.querySelector(".hero-intro");
	if (!hero) return;
	window.setTimeout(function () { hero.classList.remove("hero-intro"); }, 2500);
})();
</script>

<script>
// Bootstrap chce mít na jednom snímku třídu active. Mustache neumí
// poznat první prvek smyčky, tak ji doplníme tady.
(function () {
	var karusel = document.getElementById("heroCarousel");
	if (!karusel) return;

	var inner = karusel.querySelector(".carousel-inner");
	if (!inner) return;

	var snimky = inner.querySelectorAll(".carousel-item");
	if (snimky.length && !inner.querySelector(".carousel-item.active")) {
		snimky[0].classList.add("active");
	}

	// Tečky se skládají tady, protože mustache neumí poznat pořadí prvku
	// ve smyčce a Bootstrap potřebuje u každé data-bs-slide-to s indexem.
	// Při jediném snímku nemá co přepínat, tak se nevykreslí.
	if (snimky.length < 2) return;

	var tecky = document.createElement("div");
	tecky.className = "carousel-indicators hero-dots";

	for (var i = 0; i < snimky.length; i++) {
		var b = document.createElement("button");
		b.type = "button";
		b.setAttribute("data-bs-target", "#heroCarousel");
		b.setAttribute("data-bs-slide-to", String(i));
		b.setAttribute("aria-label", "Snímek " + (i + 1));
		if (i === 0) {
			b.className = "active";
			b.setAttribute("aria-current", "true");
		}
		tecky.appendChild(b);
	}

	karusel.appendChild(tecky);
})();
</script>

<script>
// Po odscrollování lišta ztmavne a dostane stín.
(function () {
	var hdr = document.querySelector("header");
	if (!hdr) return;
	var prepni = function () {
		hdr.classList.toggle("scrolled", window.scrollY > 20);
	};
	window.addEventListener("scroll", prepni, { passive: true });
	prepni();
})();
</script>



